# ============================================================
# Discord Bot Configuration
# ============================================================

# Your Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Your Discord Application / Client ID (from General Information in Developer Portal)
DISCORD_CLIENT_ID=your_client_id_here

# (Optional) Specific Guild ID for instant slash command testing during development.
# If omitted, slash commands are registered globally across all servers.
DISCORD_GUILD_ID=

# ============================================================
# Astra Configuration
# ============================================================

# Astra base URL (leave as default unless self-hosting Astra)
ASTRA_BASE_URL=https://astrascreen.live

# Automatically clean up / mark room ended when everyone leaves the voice channel (true/false)
AUTO_CLEANUP_ON_EMPTY=true

# (Optional) Comma-separated list of voice channel IDs to monitor.
# Leave blank to monitor ALL voice channels in the server.
# Example: VOICE_CHANNEL_IDS=123456789012345678,987654321098765432
VOICE_CHANNEL_IDS=

# Cooldown in seconds before a new room can be created in the same voice channel (prevents spam)
ROOM_COOLDOWN_SECONDS=10
